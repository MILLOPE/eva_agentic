# Local runtime config for the eva_agentic RPent vllm-user flow.
# Copy this file to .envs/eva-rpent-vllm-user/.env and fill in real values.
# The .env copy is git-ignored (under .envs/); never commit real values,
# key paths, or tokens.  scripts/with-rpent-vllm-user-env.sh sources it at
# runtime and exposes the connection/signing vars to the framework process.

# Signed Qwen vLLM user service (must be reachable from the GPU host).
RPENT_VLLM_BASE_URL=http://<HOST>:<PORT>
RPENT_VLLM_KEY_ID=<your-user-id>
RPENT_VLLM_EXPECTED_USER_ID=<your-user-id>
RPENT_VLLM_MODEL=default

# Exactly one signing mechanism is required: a private-key file OR a signer
# service URL.  Fill only one of the two lines below.
RPENT_VLLM_PRIVATE_KEY=/absolute/path/to/private/key
# RPENT_VLLM_SIGNER_URL=http://<signer-host>:<port>

# Locally hosted RPent service endpoints on the GPU host.
RPENT_SAM3_ENDPOINT=127.0.0.1:18114
RPENT_VLA_ENDPOINT=127.0.0.1:18115
