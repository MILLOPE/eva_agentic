+# ---------------------------------------------------------------------------
+# signed vLLM user-service planner
+# ---------------------------------------------------------------------------
+
+
+def _check_vllm_user(request: LlmCheckRequest) -> LlmCheckResult:
+    """Probe the optional signed vLLM integration with one raw chat request."""
+    model = (request.model or "").strip() or os.environ.get(
+        "RPENT_VLLM_MODEL", "default"
+    )
+    base_url = request.base_url or os.environ.get("RPENT_VLLM_BASE_URL") or None
+    key_present = bool(os.environ.get("RPENT_VLLM_KEY_ID"))
+
+    def _result(status: str, **kwargs: Any) -> LlmCheckResult:
+        return LlmCheckResult(
+            ok=status == STATUS_OK,
+            status=status,
+            planner="vllm_user",
+            model=model,
+            credential_env="RPENT_VLLM_KEY_ID",
+            credential_present=key_present,
+            base_url=base_url,
+            base_url_env="RPENT_VLLM_BASE_URL",
+            **kwargs,
+        )
+
+    try:
+        from rpent_vllm_user import SignedVllmClient, SignedVllmConfig
+    except ImportError as exc:
+        return _result(STATUS_SDK_ERROR, detail=_describe(exc))
+
+    timeout_s = request.resolved_timeout_s()
+    try:
+        config = SignedVllmConfig.from_env(
+            base_url_override=request.base_url,
+            model_override=request.model,
+            timeout_s=timeout_s,
+        )
+        client = SignedVllmClient(config)
+    except ValueError as exc:
+        status = (
+            STATUS_MISSING_API_KEY
+            if any(
+                name in str(exc)
+                for name in (
+                    "RPENT_VLLM_KEY_ID",
+                    "RPENT_VLLM_PRIVATE_KEY",
+                    "RPENT_VLLM_SIGNER_URL",
+                )
+            )
+            else STATUS_MISSING_CONFIG
+        )
+        return _result(status, detail=_describe(exc))
+    except Exception as exc:  # noqa: BLE001 - signing is an integration boundary
+        return _result(_classify_vllm_error(exc), detail=_describe(exc))
+
+    logger.info("probe budget: %ds", timeout_s)
+    started = time.monotonic()
+    deadline = started + timeout_s
+    try:
+        if config.expected_user_id is not None:
+            client.validate_identity(
+                timeout_s=max(deadline - time.monotonic(), 0.001)
+            )
+        remaining_s = deadline - time.monotonic()
+        if remaining_s <= 0:
+            raise TimeoutError(
+                f"the signed vLLM check did not finish within {timeout_s}s"
+            )
+        response = client.chat(
+            messages=[{"role": "user", "content": PROBE_PROMPT}],
+            model=config.model,
+            max_tokens=PROBE_MAX_TOKENS,
+            temperature=0.0,
+            timeout_s=remaining_s,
+        )
+    except Exception as exc:  # noqa: BLE001 - classify at the probe boundary
+        return _result(
+            _classify_vllm_error(exc),
+            detail=_describe(exc),
+            latency_s=round(time.monotonic() - started, 3),
+        )
+
+    latency_s = round(time.monotonic() - started, 3)
+    reply = _vllm_reply(response)
+    if not reply:
+        return _result(
+            STATUS_PROVIDER_ERROR,
+            detail="the signed vLLM service returned no assistant text.",
+            latency_s=latency_s,
+        )
+    return _result(STATUS_OK, reply=reply, latency_s=latency_s)
+
+
+def _vllm_reply(response: Any) -> str:
+    """Extract assistant text from the integration's OpenAI-compatible result."""
+    payload = getattr(response, "raw", None)
+    if not isinstance(payload, dict):
+        return ""
+    choices = payload.get("choices")
+    if not isinstance(choices, list) or not choices:
+        return ""
+    first = choices[0]
+    message = first.get("message") if isinstance(first, dict) else None
+    content = message.get("content") if isinstance(message, dict) else None
+    return content.strip() if isinstance(content, str) else ""
+
+
+def _classify_vllm_error(exc: Exception) -> str:
+    """Classify signed-service configuration, transport, and HTTP failures."""
+    text = f"{type(exc).__name__}: {exc}".lower()
+    if isinstance(exc, (ConnectionError, TimeoutError)) or any(
+        token in text
+        for token in (
+            "connection",
+            "network",
+            "timed out",
+            "timeout",
+            "transport failed",
+            "unreachable",
+            "urlerror",
+        )
+    ):
+        return STATUS_NETWORK_ERROR
+    if any(
+        token in text for token in ("401", "403", "unexpected user_id", "unexpected key_id")
+    ):
+        return STATUS_AUTH_FAILED
+    if "http 400" in text:
+        return STATUS_INVALID_MODEL
+    if any(
+        token in text
+        for token in ("private key", "signer", "rpent_vllm_key_id")
+    ):
+        return STATUS_MISSING_API_KEY
+    if re.search(r"http (404|409|413|429|5\d\d)\b", text):
+        return STATUS_PROVIDER_ERROR
+    return STATUS_SDK_ERROR
+
+
