+from __future__ import annotations
+
+import sys
+from types import ModuleType, SimpleNamespace
+
+from rpent.cli.check_llm import _parser as check_parser
+from rpent.cli.main import _build_argparser
+from rpent.dashboard.events import NullDashboardEventSink
+from rpent.planner.base import build_planner
+from rpent.planner.check import LlmCheckRequest, STATUS_OK, check_llm
+from rpent.planner.runtime import PlannerRuntime
+
+
+def test_native_factory_lazily_wraps_vllm_user(monkeypatch, tmp_path) -> None:
+    class MarkerPlanner:
+        def solve(self, **kwargs):
+            raise AssertionError(f"unexpected solve: {kwargs}")
+
+    marker = MarkerPlanner()
+    captured: dict[str, object] = {}
+    fake = ModuleType("rpent_vllm_user")
+
+    def create_planner(**kwargs):
+        captured.update(kwargs)
+        return marker
+
+    fake.create_planner = create_planner
+    monkeypatch.setitem(sys.modules, "rpent_vllm_user", fake)
+
+    result = build_planner(
+        "vllm_user",
+        output_dir=tmp_path,
+        recipe_tag="test",
+        robot_name="libero",
+        base_url="http://vllm.test/v1",
+        model="default",
+        max_tokens=123,
+        planner_timeout_s=45,
+        dashboard_events=NullDashboardEventSink(),
+        no_images=True,
+    )
+
+    assert isinstance(result, PlannerRuntime)
+    assert result.inner is marker
+    assert captured["base_url"] == "http://vllm.test/v1"
+    assert captured["model"] == "default"
+    assert captured["max_tokens"] == 123
+    assert captured["timeout_s"] == 45
+    assert captured["reasoning_effort"] == "none"
+    assert captured["dashboard_events"].enabled is False
+    assert captured["no_images"] is True
+
+
+def test_native_check_uses_signed_vllm_client(monkeypatch) -> None:
+    calls: dict[str, object] = {}
+    fake = ModuleType("rpent_vllm_user")
+
+    class Config:
+        model = "served-model"
+        expected_user_id = None
+
+        @classmethod
+        def from_env(cls, **kwargs):
+            calls["config"] = kwargs
+            return cls()
+
+    class Client:
+        def __init__(self, config):
+            calls["client_config"] = config
+
+        def chat(self, **kwargs):
+            calls["chat"] = kwargs
+            return SimpleNamespace(
+                raw={"choices": [{"message": {"content": "ok"}}]}
+            )
+
+    fake.SignedVllmConfig = Config
+    fake.SignedVllmClient = Client
+    monkeypatch.setitem(sys.modules, "rpent_vllm_user", fake)
+    monkeypatch.setenv("RPENT_VLLM_KEY_ID", "key-id")
+    monkeypatch.setenv("RPENT_VLLM_BASE_URL", "http://vllm.test")
+
+    result = check_llm(
+        LlmCheckRequest(
+            planner="vllm_user",
+            model="served-model",
+            base_url="http://vllm.test",
+            timeout_s=7,
+        )
+    )
+
+    assert result.ok is True
+    assert result.status == STATUS_OK
+    assert result.reply == "ok"
+    assert calls["config"] == {
+        "base_url_override": "http://vllm.test",
+        "model_override": "served-model",
+        "timeout_s": 7,
+    }
+    assert calls["chat"]["model"] == "served-model"
+    assert calls["chat"]["max_tokens"] == 16
+
+
+def test_native_cli_choices_include_vllm_user() -> None:
+    args = _build_argparser().parse_args(["--planner", "vllm_user"])
+    assert args.planner == "vllm_user"
+    check_args = check_parser().parse_args(["--planner", "vllm_user", "--json"])
+    assert check_args.planner == "vllm_user"
+    assert check_args.as_json is True
