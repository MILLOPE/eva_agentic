+++ b/tests/unit_tests/rpent/robots/components/test_sam3_client_compat.py
@@ -0,0 +1,38 @@
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from rpent.robots.components.sam3_client import Sam3Client
+from rpent.utils.rpc import RpcError
+
+
+class _LegacySam3Rpc:
+    def __init__(self, error: str | None = None) -> None:
+        self.calls: list[str] = []
+        self.error = error
+
+    def call(self, method: str, *, kwargs: dict[str, Any], timeout_s: float) -> dict[str, Any]:
+        self.calls.append(method)
+        if method == "sam3.segment":
+            message = self.error or "unknown RPC method: 'sam3.segment'"
+            raise RpcError(method, message)
+        return {"found": False, "reason": "legacy stub"}
+
+
+def test_sam3_client_falls_back_to_legacy_bare_method() -> None:
+    rpc = _LegacySam3Rpc()
+    result = Sam3Client(rpc).segment(b"image-bytes", text_prompt="a bottle")
+
+    assert result.found is False
+    assert rpc.calls == ["sam3.segment", "segment"]
+
+
+def test_sam3_client_does_not_mask_non_discovery_errors() -> None:
+    rpc = _LegacySam3Rpc(error="inference failed")
+
+    with pytest.raises(RpcError, match="inference failed"):
+        Sam3Client(rpc).segment(b"image-bytes", text_prompt="a bottle")
+
+    assert rpc.calls == ["sam3.segment"]
